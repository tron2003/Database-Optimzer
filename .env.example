# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is gitignored.
# ---------------------------------------------------------------------------

# --- Application's own database -------------------------------------------
DBOPT_META_DSN=postgresql+asyncpg://dbopt:dbopt@localhost:5433/dbopt_meta

# --- Bundled sandbox ------------------------------------------------------
# Registered automatically on first boot when AUTO_REGISTER is true.
# Two DSNs, two roles: the monitor DSN is read-only at the server level, the
# apply DSN is used only to execute an approved suggestion.
DBOPT_SANDBOX_DSN=postgresql://dbopt_monitor:monitor@localhost:5434/shopdb
DBOPT_SANDBOX_APPLY_DSN=postgresql://dbopt_apply:apply@localhost:5434/shopdb
DBOPT_SANDBOX_AUTO_REGISTER=true

# --- Collector ------------------------------------------------------------
DBOPT_POLL_INTERVAL_SECONDS=5
DBOPT_SNAPSHOT_RETENTION_HOURS=48

# --- Safety ---------------------------------------------------------------
# Applied to every session the monitor opens against a target database.
DBOPT_STATEMENT_TIMEOUT_MS=5000
DBOPT_LOCK_TIMEOUT_MS=2000
DBOPT_IDLE_TX_TIMEOUT_MS=10000
# Max pooled connections PER monitored database. Keep this small: the monitor
# must never become a meaningful consumer of the connection slots it reports on.
DBOPT_TARGET_POOL_MAX=3
# Strip literals from query text before it leaves the process for a cloud LLM.
DBOPT_REDACT_LITERALS=true

# --- LLM ------------------------------------------------------------------
# One of: ollama | anthropic | openai | none
# "none" disables every LLM feature; the deterministic analysis still works.
DBOPT_LLM_PROVIDER=ollama

DBOPT_OLLAMA_BASE_URL=http://localhost:11434
DBOPT_OLLAMA_MODEL=qwen2.5-coder:14b

DBOPT_ANTHROPIC_API_KEY=
DBOPT_ANTHROPIC_MODEL=claude-sonnet-4-5

DBOPT_OPENAI_API_KEY=
DBOPT_OPENAI_BASE_URL=https://api.openai.com/v1
DBOPT_OPENAI_MODEL=gpt-4o

DBOPT_LLM_TIMEOUT_SECONDS=120
DBOPT_LLM_MAX_OUTPUT_TOKENS=4096

# --- API ------------------------------------------------------------------
DBOPT_CORS_ORIGINS=http://localhost:3000
DBOPT_LOG_LEVEL=INFO
